# Firebase Console > Project settings > Your apps > Web app SDK configuration.
# These are public client identifiers, not service account secrets.
EXPO_PUBLIC_FIREBASE_API_KEY=replace_me
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=replace_me.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=replace_me
EXPO_PUBLIC_FIREBASE_APP_ID=replace_me
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=replace_me
# Optional in v0.3 (not required for Firestore or Anonymous Auth)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=replace_me.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=replace_me

# Optional: for an Android custom development build, not Expo Go
# GOOGLE_MAPS_API_KEY_ANDROID=your_restricted_maps_sdk_android_key
